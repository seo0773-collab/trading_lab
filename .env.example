# Optional API keys
# POLYGON_API_KEY=
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# BINANCE_API_KEY=
# BINANCE_SECRET_KEY=

# --- 한국투자증권(KIS) ---
# 시세(실데이터 도메인)용 실키. 잔고/일봉도 이 키로 조회.
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ACCOUNT=12345678-01   # 8자리-2자리
# KIS_ENV=mock              # mock | real (주문 도메인)

# 모의 국내(KRW) 주문용. ⚠️ 반드시 '모의투자 참가 신청'으로 발급된 모의 계좌/키여야
# 주문이 나간다(실키를 모의 도메인에 쓰면 '모의투자 주문이 불가한 계좌' 거부).
# KIS_MOCK_APP_KEY=
# KIS_MOCK_APP_SECRET=
# KIS_MOCK_ACCOUNT=50000000-01

# 해외(USD) 모의 주문도 KIS_MOCK_* 계좌/키를 사용한다.
